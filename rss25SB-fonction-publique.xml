    </item>
    <item>
        <guid>https://www.fonction-publique.gouv.fr/toutes-les-actualites/123-laureats-pour-le-fonds-en-faveur-de-legalite-professionnelle-2025</guid>
        <title>123 lauréats pour le fonds en faveur de l’égalité professionnelle 2025</title>
        <category term="fonction-publique"/>
        <category term="administration"/>
        <category term="public"/>
        <published>2025-05-26T23:19:34.648341759</published>
        <image type="JPEG" href="https://www.fonction-publique.gouv.fr/themes/custom/marianne/images/logo.png" alt="Image par défaut pour fonction-publique" length="1024"/>
        <content type="text">Prévu par l’accord relatif à l’égalité professionnelle entre les femmes et les hommes dans la fonction publique du 30 novembre 2018, le fonds en faveur de l’égalité professionnelle (FEP), cofinance pour la campagne 2025, 123 projets en faveur de l’égalité professionnelle portés par des administrations.</content>
        <author>
            <name>Fonction Publique</name>
            <email>communication@fonction-publique.gouv.fr</email>
            <uri>https://www.fonction-publique.gouv.fr</uri>
        </author>
    </item>
